# Copy to .env and fill in. Variable names follow cognite-toolkit 0.8.x.
# Run `uv run cdf auth init` to generate a .env interactively instead.
CDF_CLUSTER=<cluster>
CDF_PROJECT=<cdf_project>
# cdf = Cognite IdP (token URL https://auth.cognite.com/oauth2/token is set automatically)
# Other options: entra_id (also set IDP_TENANT_ID), auth0, other (also set IDP_TOKEN_URL)
PROVIDER=cdf
LOGIN_FLOW=client_credentials
IDP_CLIENT_ID=<client_id>
IDP_CLIENT_SECRET=<client_secret>
# IDP_TENANT_ID=<tenant_id>
# IDP_TOKEN_URL=<token_url>
CDF_CLIENT_TIMEOUT=30
CDF_CLIENT_MAX_WORKERS=5

# Group source IDs (from your IdP) used by config.<env>.yaml
GROUP_SOURCE_ID=<group_source_id>
ADMIN_SOURCE_ID=<admin_source_id>
CONSUMER_SOURCE_ID=<consumer_source_id>
OWNER_GROUP_SOURCE_ID=<owner_group_source_id>
PRODUCER_SOURCE_ID=<producer_source_id>
READ_GROUP_SOURCE_ID=<read_group_source_id>
